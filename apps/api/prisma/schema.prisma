// Responsibility:
// Defines the database structure for the Zionra API.
//
// This schema supports password authentication, Google authentication,
// email verification, password reset, and database-backed rolling sessions.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
}

enum OAuthProvider {
  GOOGLE
}

model Customer {
  id                 String         @id @default(cuid())
  firstName          String
  lastName           String
  email              String         @unique
  phoneCountryCode   String
  phoneNumber        String
  passwordHash       String?
  countryOfResidence String
  referralSource     String?
  acceptedTermsAt    DateTime
  marketingOptIn     Boolean        @default(false)
  emailVerifiedAt    DateTime?
  status             CustomerStatus @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  emailVerificationCodes CustomerEmailVerificationCode[]
  passwordResetCodes          CustomerPasswordResetCode[]
  passwordResetAuthorizations CustomerPasswordResetAuthorization[]
  loginChallenges             CustomerLoginChallenge[]
  sessions                    CustomerSession[]
  oauthAccounts               CustomerOAuthAccount[]

  @@index([email])
  @@index([phoneCountryCode, phoneNumber])
}

model CustomerEmailVerificationCode {
  id        String    @id @default(cuid())
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([codeHash])
}

model CustomerPasswordResetCode {
  id        String    @id @default(cuid())
  codeHash  String
  expiresAt DateTime
  usedAt         DateTime?
  failedAttempts Int       @default(0)
  createdAt      DateTime  @default(now())

  customerId   String
  customer     Customer                           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorization CustomerPasswordResetAuthorization?

  @@index([customerId])
  @@index([codeHash])
}

model CustomerPasswordResetAuthorization {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  passwordResetCodeId String                    @unique
  passwordResetCode   CustomerPasswordResetCode @relation(fields: [passwordResetCodeId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}


model CustomerLoginChallenge {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  codeHash       String
  codeExpiresAt  DateTime
  expiresAt      DateTime
  failedAttempts Int       @default(0)
  emailSendCount Int       @default(1)
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

model CustomerSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

model CustomerOAuthAccount {
  id                String        @id @default(cuid())
  provider          OAuthProvider
  providerAccountId String
  email             String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([provider, customerId])
  @@index([email])
}

model CustomerOAuthSignup {
  id                String        @id @default(cuid())
  provider          OAuthProvider
  providerAccountId String
  tokenHash         String        @unique
  email             String
  firstName         String
  lastName          String
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([provider, providerAccountId])
  @@index([email])
  @@index([expiresAt])
}

enum ShippingPartnerStatus {
  ONBOARDING
  APPLICATION_SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

model ShippingPartner {
  id                 String                @id @default(cuid())
  firstName          String
  lastName           String
  email              String                @unique
  phoneCountryCode   String
  phoneNumber        String
  passwordHash       String?
  countryOfResidence String
  referralSource     String?
  acceptedTermsAt    DateTime
  marketingOptIn     Boolean               @default(false)
  emailVerifiedAt    DateTime?
  status             ShippingPartnerStatus @default(ONBOARDING)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  emailVerificationCodes ShippingPartnerEmailVerificationCode[]
  onboardingSessions     ShippingPartnerOnboardingSession[]
  oauthAccounts          ShippingPartnerOAuthAccount[]
  application            ShippingPartnerApplication?

  @@index([email])
  @@index([phoneCountryCode, phoneNumber])
  @@index([status])
}

model ShippingPartnerEmailVerificationCode {
  id        String    @id @default(cuid())
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  partnerId String
  partner   ShippingPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([codeHash])
}

model ShippingPartnerOnboardingSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  partnerId String
  partner   ShippingPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([expiresAt])
}

model ShippingPartnerOAuthAccount {
  id                String        @id @default(cuid())
  provider          OAuthProvider
  providerAccountId String
  email             String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  partnerId String
  partner   ShippingPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([provider, partnerId])
  @@index([email])
}

model ShippingPartnerOAuthSignup {
  id                String        @id @default(cuid())
  provider          OAuthProvider
  providerAccountId String
  tokenHash         String        @unique
  email             String
  firstName         String
  lastName          String
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([provider, providerAccountId])
  @@index([email])
  @@index([expiresAt])
}

enum ShippingPartnerApplicationStep {
  BUSINESS_INFORMATION
  OPERATIONAL_DETAILS
  ACCOUNT_INFORMATION
  REVIEW
  SUBMITTED
}

model ShippingPartnerApplication {
  id                         String                         @id @default(cuid())
  currentStep                ShippingPartnerApplicationStep @default(BUSINESS_INFORMATION)

  registeredBusinessName     String?
  companyEmailAddress        String?
  businessAddress            String?
  companyHouseNumber         String?
  companyPhoneCountryCode    String?
  companyPhoneNumber         String?
  website                    String?

  collectionCities           String[]                       @default([])
  itemsHandled               String[]                       @default([])
  operationalBusinessAddress String?
  shippingMethod             String?
  shipmentFrequency          String?
  airCargoPricePerKg         Decimal?                       @db.Decimal(12, 2)
  seaCargoPricePerKg         Decimal?                       @db.Decimal(12, 2)
  pricePerBarrel             Decimal?                       @db.Decimal(12, 2)
  insuranceAvailable         Boolean?
  upfrontImmigrationCharge   Boolean?

  companyLogoUrl             String?
  companyLogoPublicId        String?
  companyLogoFormat          String?
  companyLogoBytes           Int?
  companyBio                 String?
  responseTime               String?
  collectionMethod           String?
  deliveryMethod             String?

  applicationReference         String?                        @unique
  submittedAt                  DateTime?
  submissionEmailSentAt        DateTime?
  submissionEmailLastAttemptAt DateTime?
  submissionEmailLastError     String?
  createdAt                    DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt

  partnerId                  String                         @unique
  partner                    ShippingPartner                @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  contacts                   ShippingPartnerApplicationContact[]

  @@index([currentStep])
  @@index([submittedAt])
  @@index([submittedAt, submissionEmailSentAt], map: "partner_application_submission_email_pending_idx")
}

model ShippingPartnerApplicationContact {
  id               String                     @id @default(cuid())
  fullName         String
  jobTitle         String
  email            String
  phoneCountryCode String
  phoneNumber      String
  isPrimary        Boolean                    @default(false)
  position         Int                        @default(0)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  applicationId    String
  application      ShippingPartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, position])
  @@index([email])
}

